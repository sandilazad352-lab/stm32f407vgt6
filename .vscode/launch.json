{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug STM32F407 (Cortex-Debug + SVD)",
      "type": "cortex-debug",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "executable": "${workspaceFolder}/build/STM32_BLACK_BOX.elf",
      "servertype": "openocd",
      "serverpath": "C:/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.openocd.win32_2.4.500.202604080855/tools/bin/openocd.exe",
      "searchDir": [
        "C:/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.debug.openocd_2.3.400.202606220929/resources/openocd/st_scripts"
      ],
      "configFiles": [
        "interface/stlink-dap.cfg",
        "target/stm32f4x.cfg"
      ],
      "device": "STM32F407VET6",
      "svdFile": "${workspaceFolder}/Drivers/CMSIS/SVD/STM32F407.svd",
      "runToEntryPoint": "main",
      "preLaunchTask": "Build STM32_BLACK_BOX",
      "showDevDebugOutput": "none"
    },
    {
      "name": "Debug STM32F407 (OpenOCD + GDB)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/STM32_BLACK_BOX.elf",
      "args": [],
      "stopAtEntry": true,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb.exe",
      "miDebuggerServerAddress": "localhost:3333",
      "preLaunchTask": "Start OpenOCD GDB Server",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        },
        {
          "description": "Reset and halt CPU",
          "text": "monitor reset halt",
          "ignoreFailures": false
        },
        {
          "description": "Load ELF symbols into flash",
          "text": "load",
          "ignoreFailures": false
        }
      ]
    },
    {
      "name": "Attach to STM32F407 (Live Target)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/STM32_BLACK_BOX.elf",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "environment": [],
      "externalConsole": false,
      "MIMode": "gdb",
      "miDebuggerPath": "C:/ST/STM32CubeIDE_2.2.0/STM32CubeIDE/plugins/com.st.stm32cube.ide.mcu.externaltools.gnu-tools-for-stm32.14.3.rel1.win32_1.0.100.202602081740/tools/bin/arm-none-eabi-gdb.exe",
      "miDebuggerServerAddress": "localhost:3333",
      "setupCommands": [
        {
          "description": "Enable pretty-printing for gdb",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
